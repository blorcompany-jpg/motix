{
  "name": "motix",
  "private": true,
  "version": "0.1.0",
  "description": "MOTIX – piattaforma BTECH S.r.l. per allenamento, benessere e idratazione",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev:api": "npm run dev -w @motix/api",
    "dev:web": "npm run dev -w @motix/web",
    "dev:mobile": "npm run start -w @motix/mobile",
    "db:generate": "npm run db:generate -w @motix/api",
    "db:migrate": "npm run db:migrate -w @motix/api",
    "seed": "npm run seed -w @motix/api",
    "test": "npm run test -w @motix/api",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": { "node": ">=20" }
}
