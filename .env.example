# API
PORT=4000
DATABASE_URL=postgres://motix:motix@localhost:5432/motix
JWT_SECRET=cambia-questa-chiave-con-almeno-32-caratteri-casuali
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
# Cartella dei file caricati (foto e video) in sviluppo
MEDIA_DIR=./.data/media
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# Email (in sviluppo le email vengono scritte nel log)
MAIL_FROM=MOTIX <no-reply@motix.app>
# Motore AI (services/ai). AI_KEY deve essere uguale ad AI_SERVICE_KEY del servizio
AI_URL=http://localhost:8000
AI_KEY=
# Primo amministratore BTECH (usato da "npm run seed")
ADMIN_EMAIL=admin@btech.example
ADMIN_PASSWORD=cambia-subito-questa-password
# Web e app
VITE_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
# Solo in sviluppo: simula il sensore motix pod nell'app (numero di serie MP-SIM001)
EXPO_PUBLIC_POD_SIMULATOR=1
